# Dependencies
node_modules/

# Environment / secrets — template stays tracked
# Holds MONGOOSE_URI, SECRET_KEY and SMTP credentials — never commit.
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / process
pids/
*.pid
*.seed
*.pid.lock

# Test & tooling caches
coverage/
.nyc_output/
.eslintcache

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sw?

# Operating system
.DS_Store
Thumbs.db
desktop.ini
